<details>
<summary>📊 Poll </summary>

```js
await sock.sendMessage(jid, {
  poll: {
    name: 'Choose one',
    values: ['Option A', 'Option B', 'Option C'],
    selectableCount: 1 // 0 = many selectable
  }
})

// Poll with additional features
await sock.sendMessage(jid, {
  poll: {
    name: 'Poll Name',
    values: ['Option A', 'Option B'],
    selectableCount: 1,
    endDate: new Date('2025-12-31'),
    hideVoter: true,
    canAddOption: false,
    to Announcement Group: false
  }
})

// Quiz (Poll with correct answers)
await sock.sendMessage(jid, {
  poll: {
    name: 'Capital of Indonesia?',
    values: ['Jakarta', 'Surabaya', 'Bandung'],
    selectableCount: 1,
    pollType: 1, // 1 = QUIZ
    correctAnswer: 'Jakarta'
  }
})
```

